pkgname=openxplore
pkgver=0.1.0
pkgrel=1
pkgdesc='Read, write and mount Xbox 360 FATX drives and images'
arch=(x86_64)
license=(GPL-3.0-only)
depends=(fuse3 gcc-libs glibc libnotify polkit systemd xdg-utils)
makedepends=(cargo)
options=(!debug)

build() {
  cd "$startdir/.."
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$startdir/.."
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/target/release/openxplore" -t "$pkgdir/usr/bin"
  install -Dm644 packaging/openxplore.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/icons/openxplore.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/io.github.openxplore.policy -t "$pkgdir/usr/share/polkit-1/actions"
  install -Dm644 packaging/70-openxplore.rules -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
